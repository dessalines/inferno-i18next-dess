{
	"name": "inferno-i18next-dess",
	"description": "A translation utility for Inferno components using the i18next ecosystem.",
	"version": "0.0.3",
	"keywords": [
		"i18n",
		"l10n",
		"internationalization",
		"localization",
		"translation",
		"inferno",
		"i18next"
	],
	"license": "MIT",
	"main": "dist/bundle.js",
	"browser": "dist/bundle.js",
	"jsnext:main": "src/index.js",
	"devDependencies": {
		"@babel/core": "^8.1.0",
		"@babel/plugin-proposal-class-properties": "^7.10.4",
		"@babel/preset-env": "^8.0.7",
		"babel-jest": "^30.5.2",
		"babel-plugin-inferno": "^10.0.0",
		"codecov": "^3.7.2",
		"cross-env": "^10.1.0",
		"eslint": "^8.23.1",
		"eslint-plugin-import": "^2.22.0",
		"eslint-plugin-inferno": "^7.20.1",
		"i18next": "^21.9.2",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"rollup": "^4.67.4",
		"rollup-plugin-babel": "^4.4.0",
		"rollup-plugin-uglify": "^6.0.4"
	},
	"dependencies": {
		"html-parse-stringify2": "^2.0.1",
		"inferno": "^10.0.0",
		"inferno-clone-vnode": "^10.0.0",
		"inferno-create-element": "^10.0.0",
		"inferno-shared": "^10.0.0",
		"inferno-vnode-flags": "^10.0.0"
	},
	"scripts": {
		"build": "rollup -c",
		"build-all": "npm run build-dev && npm run build-prod",
		"build-dev": "cross-env NODE_ENV=development npm run build",
		"build-prod": "cross-env NODE_ENV=production npm run build",
		"test": "eslint src && jest",
		"upload-cov": "codecov"
	}
}
